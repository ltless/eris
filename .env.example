# llama.cpp model (set MODEL_PATH to auto-start llama-server, else leave empty)
MODEL_PATH=
LLAMA_BIN=llama-server

# llama.cpp OpenAI-compatible server
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen3.5:4b
MODEL_API_KEY=sk-no-key

SYSTEM_PROMPT="You are Eris, a helpful assistant. Answer clearly and use markdown when useful."
# Auth (sqlite session store)
AUTH_DB=database/users.db

# Chat history (sqlite)
CHAT_DB=database/chats.db

# SearXNG (web search tool)
SEARXNG_URL=http://localhost:8082
SEARXNG_TOP_K=4
SEARXNG_LANGUAGE=en
SEARXNG_TIME_RANGE=

# Fetch full page text of the top web results (1=on)
FETCH_PAGES=1
FETCH_TOP=3
FETCH_MAX_CHARS=2000
MAX_TOOL_ROUNDS=3
# Rounds the model may earn beyond MAX_TOOL_ROUNDS, one per round that turned
# up a source it had not already seen. A repeated search returns the same
# pages, so the loop stops there instead of spending the run on it.
EXTRA_TOOL_ROUNDS=4

# API tokens: credentials for scripts and MCP clients (sqlite). A token is read
# scope — it may call the API and /mcp, and no route that changes the account.
TOKENS_DB=database/tokens.db