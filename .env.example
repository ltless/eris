# llama.cpp model (set MODEL_PATH to auto-start llama-server, else leave empty)
MODEL_PATH=
LLAMA_BIN=llama-server

# llama.cpp OpenAI-compatible server (start with --embeddings for RAG)
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen3.5:4b
MODEL_API_KEY=sk-no-key
EMBED_MODEL=qwen3.5:4b

# ChromaDB (docker compose)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=eris

RAG_TOP_K=4
SYSTEM_PROMPT="You are Eris, a helpful assistant. Answer clearly and use markdown when useful."
# Auth (sqlite session store)
AUTH_DB=users.db

# SearXNG (web search tool)
SEARXNG_URL=http://localhost:8082
SEARXNG_TOP_K=4
SEARXNG_LANGUAGE=en
SEARXNG_TIME_RANGE=
